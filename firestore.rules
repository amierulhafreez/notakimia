rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'amierulhafreez@gmail.com' ||
        request.auth.token.email == 'hafreez@gmail.com' ||
        request.auth.token.email == 'cikguhafreez@gmail.com' ||
        request.auth.token.email == 'admin@cikguhafreez.my'
      );
    }

    match /nota_kimia_users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /nota_kimia_access_codes/{codeId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.isRedeemed == false &&
        request.resource.data.isRedeemed == true &&
        request.resource.data.code == resource.data.code
      );
    }
  }
}
